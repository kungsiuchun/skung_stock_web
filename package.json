{
  "name": "sius-ai-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npx wrangler pages dev . --port 8788 --compatibility-date=2024-04-01\"",
    "build": "tsc && vite build",
    "d1:migrate:local": "wrangler d1 migrations apply spx-recap-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply spx-recap-db --remote",
    "spx:backfill:dry": "tsx scripts/backfill-spx-recap.ts --dry-run",
    "spx:backfill": "tsx scripts/backfill-spx-recap.ts --apply",
    "deploy": "npm run deploy:site && npm run deploy:spx",
    "deploy:site": "node scripts/sync-secrets.js && wrangler pages deploy dist --project-name sius-ai-workshop",
    "deploy:spx": "wrangler deploy --config wrangler.spx.toml",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "input": "^1.0.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.378.0",
    "motion": "^12.4.7",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "playwright": "^1.59.1",
    "puppeteer": "^24.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "technicalindicators": "^3.1.0",
    "telegram": "^2.26.22",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "wrangler": "^4.72.0"
  }
}
